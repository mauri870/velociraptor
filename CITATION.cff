cff-version: 1.2.0
title: "velociraptor"
message: "If you use this package, please cite the paper (preferred-citation), the version of TRICERATOPS it computes with and the closed-form light curve it implements (references)."
type: software
authors:
  - family-names: "Meneguzzo"
    given-names: "Mauri de Souza"
version: "0.1.0"
date-released: 2026-11-07
license: MIT
repository-code: "https://github.com/mauri870/velociraptor"
url: "https://github.com/mauri870/velociraptor"
abstract: "A fast GPU drop-in for TRICERATOPS that tells transiting exoplanets from false positives, with an exact transit light curve."
preferred-citation:
  type: unpublished
  title: "velociraptor: exact light curves and GPU-accelerated false-positive probabilities for TESS planet candidates"
  authors:
